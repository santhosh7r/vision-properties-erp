# ──────────────────────────────────────────────────────────────
# Vision Properties — environment configuration
# Copy this file to .env.local and fill in your Supabase values.
# ──────────────────────────────────────────────────────────────

# Supabase project URL (Project Settings → API → Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# Supabase SERVICE ROLE key (Project Settings → API → service_role).
# Server-only. NEVER expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Secret used to sign session cookies. Use a long random string.
# Generate one with: openssl rand -base64 48
AUTH_SECRET=change-me-to-a-long-random-secret

# Password the seed/reset scripts assign to seeded logins (db:seed / db:seed:team
# / db:fix-logins). Never commit a real password — keep it only in .env.local.
SEED_PASSWORD=change-me

# ──────────────────────────────────────────────────────────────
# Prisma — schema migrations against the SAME Supabase database
# ──────────────────────────────────────────────────────────────
# Supabase Dashboard → Project Settings → Database → Connection string.
# Both of these point at the database that NEXT_PUBLIC_SUPABASE_URL serves;
# Prisma just talks to it over plain Postgres instead of over PostgREST.

# Pooled connection (port 6543). Used by the application at runtime if it ever
# queries through Prisma. Safe for serverless — add ?pgbouncer=true.
DATABASE_URL=

# DIRECT connection (port 5432). Used by `prisma migrate` for DDL. This one is
# required: the pooler cannot run migrations.
DIRECT_URL=

# A scratch database Prisma uses to work out what each migration should contain.
# Supabase will not let it create one on the hosted instance, so point this at a
# local Postgres, e.g.
#   createdb vp_shadow
#   SHADOW_DATABASE_URL=postgresql://<you>@localhost:5432/vp_shadow
SHADOW_DATABASE_URL=

# ──────────────────────────────────────────────────────────────
# Error monitoring
# ──────────────────────────────────────────────────────────────
# Stamped on every error log row so "is this still happening after the fix?" is
# answerable. Any string: a version, a build number, a commit sha.
NEXT_PUBLIC_APP_VERSION=
