  refund_approved_by                        String?            @db.Uuid
  refund_approved_at                        DateTime?          @db.Timestamptz(6)
  refund_due_date                           DateTime?          @db.Date
  refund_paid_at                            DateTime?          @db.Timestamptz(6)
  partner_code                              String?
  director_code                             String?
  senior_director_id                        String?            @db.Uuid
  senior_director_code                      String?
  senior_director_name                      String?
  cab_tokens_issued                         Boolean            @default(false)
  cancel_requested_by                       String?            @db.Uuid
  cancel_requested_at                       DateTime?          @db.Timestamptz(6)
  cancel_request_reason                     String?
  expired_at                                DateTime?          @db.Timestamptz(6)
  pre_expiry_status                         booking_status?
  receipt_no                                String?            @unique(map: "uniq_bookings_receipt_no") @default(dbgenerated("('VPO'::text || nextval('booking_receipt_seq'::regclass))"))
  payment_receipt_seq                       Int                @default(0)
  users_bookings_cancel_requested_byTousers users?             @relation("bookings_cancel_requested_byTousers", fields: [cancel_requested_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users_bookings_created_byTousers          users?             @relation("bookings_created_byTousers", fields: [created_by], references: [id], onUpdate: NoAction)
  customers                                 customers          @relation(fields: [customer_id], references: [id], onUpdate: NoAction)
  users_bookings_director_idTousers         users?             @relation("bookings_director_idTousers", fields: [director_id], references: [id], onUpdate: NoAction)
  users_bookings_partner_idTousers          users?             @relation("bookings_partner_idTousers", fields: [partner_id], references: [id], onUpdate: NoAction)
  plots                                     plots              @relation(fields: [plot_id], references: [id], onUpdate: NoAction)
  projects                                  projects           @relation(fields: [project_id], references: [id], onUpdate: NoAction)
  users_bookings_refund_approved_byTousers  users?             @relation("bookings_refund_approved_byTousers", fields: [refund_approved_by], references: [id], onUpdate: NoAction)
  users_bookings_senior_director_idTousers  users?             @relation("bookings_senior_director_idTousers", fields: [senior_director_id], references: [id], onUpdate: NoAction)
  notifications                             notifications[]
  payments                                  payments[]
  plot_transfers                            plot_transfers[]
  registrations                             registrations[]
  service_requests                          service_requests[]

  @@index([created_by], map: "idx_bookings_creator")
  @@index([customer_id], map: "idx_bookings_customer")
  @@index([expired_at], map: "idx_bookings_expired_at", where: raw("(expired_at IS NOT NULL)"))
  @@index([plot_id], map: "idx_bookings_plot")
  @@index([status], map: "idx_bookings_status")
