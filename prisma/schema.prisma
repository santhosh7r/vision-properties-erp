/// Global error monitoring. One row per DISTINCT problem, keyed by `fingerprint`
/// — not one row per occurrence. Written only by the server-side capture layer
/// (src/lib/errors/capture.ts) through the record_error() function, and read
/// only by the developer Error Logs page.
///
/// The upsert/dedup function, the CHECK constraints and the RLS lock-down live
/// in this model's migration SQL, since Prisma's schema language cannot express
/// them. See docs/ERROR_HANDLING.md.
model error_logs {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fingerprint      String    @unique
  short_id         String    @unique(map: "idx_error_logs_short_id")

  name             String?
  message          String?
  raw_message      String?
  code             String?
  kind             String    @default("unknown")
  severity         String    @default("error")
  source           String    @default("server")

  module           String?
  route            String?
  api_endpoint     String?
  http_method      String?
  http_status      Int?

  stack            String?
  component_stack  String?
  db_details       Json?
  context          Json?

  request_id       String?
  user_id          String?   @db.Uuid
  user_email       String?
  user_role        String?
  url              String?
  user_agent       String?
  browser          String?
  os               String?
  device           String?
  runtime          String?
  environment      String    @default("production")
  release          String?

  occurrence_count Int       @default(1)
  first_seen_at    DateTime  @default(now()) @db.Timestamptz(6)
  last_seen_at     DateTime  @default(now()) @db.Timestamptz(6)
  last_event_id    String?
  recent           Json      @default("[]")
  affected_users   Json      @default("[]")

  status           String    @default("new")
  resolved_at      DateTime? @db.Timestamptz(6)
  resolved_by      String?   @db.Uuid
  resolved_by_name String?
  resolution_notes String?

  created_at       DateTime  @default(now()) @db.Timestamptz(6)
  updated_at       DateTime  @default(now()) @db.Timestamptz(6)

  users_error_logs_user_idTousers     users? @relation("error_logs_user_idTousers", fields: [user_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  users_error_logs_resolved_byTousers users? @relation("error_logs_resolved_byTousers", fields: [resolved_by], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([last_seen_at(sort: Desc)], map: "idx_error_logs_last_seen")
  @@index([status, last_seen_at(sort: Desc)], map: "idx_error_logs_status")
  @@index([severity, last_seen_at(sort: Desc)], map: "idx_error_logs_severity")
  @@index([module], map: "idx_error_logs_module")
  @@index([source], map: "idx_error_logs_source")
  @@index([environment], map: "idx_error_logs_env")
  @@index([last_event_id], map: "idx_error_logs_last_event")
}
